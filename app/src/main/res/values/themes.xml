<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Cloud" parent="Theme.AppCompat.DayNight.NoActionBar">

    </style>

    <style name="Theme.Cloud.Dialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="Theme.Cloud.BottomSheet" parent="Theme.Design.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="bottomSheetStyle">@style/Widget.Cloud.BottomSheet</item>
    </style>

    <style name="Widget.Cloud.BottomSheet" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="behavior_hideable">true</item>
        <item name="behavior_skipCollapsed">true</item>
    </style>

    <style name="Widget.Cloud.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.Cloud.IconButton" parent="Widget.AppCompat.Button">
        <item name="android:fontFamily">@font/icons</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="Theme.Cloud.IconButton.AppBar" parent="Theme.Cloud.IconButton">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize" tools:ignore="SpUsage">16dp</item>
    </style>

    <style name="Theme.Cloud.IconButton.FloatingMenu" parent="Theme.Cloud.IconButton">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize" tools:ignore="SpUsage">28dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
    </style>

    <style name="Theme.Cloud.Fab" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:background">@drawable/bg_floating_circle_button</item>
        <item name="android:elevation">6dp</item>
        <item name="android:fontFamily">@font/icons</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize" tools:ignore="SpUsage">34dp</item>
    </style>

    <style name="Theme.Cloud.SolidButton" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/bg_solid_button</item>
    </style>

    <style name="Theme.Cloud.OutlineButton" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/bg_outline_button</item>
    </style>

    <style name="Theme.Cloud.OutlineInput" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_outline_input</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="Theme.Cloud.DropdownButton" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/bg_outline_button</item>
    </style>
</resources>
